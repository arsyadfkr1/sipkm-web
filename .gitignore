# =============================================
# SIPKM — .gitignore
# =============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Prisma
prisma/dev.db
prisma/dev.db-journal

# Environment variables — JANGAN pernah di-commit!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User uploads (file besar, simpan di Cloudinary untuk production)
public/uploads/avatars/
public/uploads/laporan/

# Temp scripts
seed-notif.js
seed-forum.js
sync-forum.js
